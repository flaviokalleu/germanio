pagina "/exemplos"
    titulo "Exemplos — Germanio"

    navbar
        logo "/assets/germanio.png" "Germanio"
        link "Início" "/"
        link "Documentação" "/docs"
        link "Exemplos" "/exemplos"
        link "Aprender" "/aprender"
        botao "Instalar" "/instalar"

    hero
        badge "EXEMPLOS PRÁTICOS"
        titulo "Da Ideia ao Software."
        descricao "Programas descritos em intenção. Os trechos abaixo vêm de programas que passam no ge check."
        botao primario "Ver no GitHub" "https://github.com/flaviokalleu/germanio/tree/master/examples"
        botao secundario "Documentação" "/docs"

    secao "Projetos de Exemplo"
        subtitulo "Este portal também é escrito em .ge, com as páginas técnicas (pagina \"/caminho\")."
        grade 3 colunas
            card
                icone "📇"
                tag "PRIMEIRO PROGRAMA"
                titulo "Cadastro de Clientes"
                texto "Um dado, uma página e pesquisa: cadastrar, editar e excluir sem escrever rotas nem SQL."
                code "crie sistema Clientes\n\nclientes\n    tem\n        nome obrigatório\n        email obrigatório e único\n        telefone\n\n    permita\n        pesquisar\n\npágina Clientes\n    mostre clientes\n    permita\n        cadastrar\n        editar\n        excluir"
                link "/aprender"
            card
                icone "🛍️"
                tag "MODELO DE PROJETO"
                titulo "Loja"
                texto "O projeto criado com backend/ e frontend/: produtos, pedidos, login e administrador."
                code "produtos\n    acesso\n        todos\n            ver\n        somente administrador\n            criar\n            editar\n            excluir"
                link "https://github.com/flaviokalleu/germanio/tree/master/cli/modelos/organizado"
            card
                icone "🦊"
                tag "APLICAÇÃO DE PROVA"
                titulo "GitLab FOSS em .ge"
                texto "Uma reimplementação do GitLab FOSS em intenção: grupos, projetos, issues, merge requests e pipelines."
                code "issues\n    começa aberta\n\n    pode\n        fechar\n        reabrir\n        ser confidencial\n\n    acesso\n        usuario\n            criar\n            comentar\n        somente maintainer\n            excluir"
                link "https://github.com/flaviokalleu/germanio/tree/master/examples/gitlab-foss"

    rodape
        copyright "Germanio © 2026 — Exemplos."
        link "GitHub" "https://github.com/flaviokalleu/germanio"
        link "Início" "/"
        link "Docs" "/docs"
