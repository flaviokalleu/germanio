pagina "/"
    titulo "Germanio — Diga o que quer construir"

    navbar
        logo "/assets/germanio.png" "Germanio"
        link "Início" "/"
        link "Documentação" "/docs"
        link "Exemplos" "/exemplos"
        link "Aprender" "/aprender"
        link "Experimentar" "/playground"
        link "Comunidade" "/comunidade"
        botao "Instalar" "/instalar"

    hero
        badge "VERSÃO 0.7.0-DEV · EM DESENVOLVIMENTO"
        titulo "Diga o que quer construir."
        destaque "Germanio transforma em software."
        descricao "Uma linguagem orientada à intenção: você descreve o que existe, quem pode fazer o quê, o que acontece e o que aparece. O Germanio deriva o banco, a API, as permissões e as páginas, de forma determinística e sem IA na execução."
        botao primario "Começar com Germanio →" "/docs"
        botao secundario "Como experimentar" "/playground"
        comando "curl -fsSL https://raw.githubusercontent.com/flaviokalleu/germanio/master/install.sh | bash"
        codigo "clientes.ge" "crie sistema Clientes\n\nclientes\n    tem\n        nome obrigatório\n        email obrigatório e único\n        telefone\n\n    permita\n        pesquisar\n\npágina Clientes\n    mostre clientes\n    permita\n        cadastrar\n        editar\n        excluir"

    secao "Pilares Fundamentais"
        subtitulo "Sem rodeios, sem complexidade acidental: o programa diz o quê; o Germanio resolve o como."
        grade 3 colunas
            card
                icone "⚡"
                tag "ERGONOMIA"
                titulo "Simples de Aprender"
                texto "Frases do domínio, cada uma com um único significado. Sem rotas, SQL, controllers nem boilerplate."
                link "/aprender"
            card
                icone "🔷"
                tag "FULL-STACK"
                titulo "Full-stack por Natureza"
                texto "Declare dados, permissões e páginas; o Germanio deriva o banco, a API e a interface."
                link "/docs"
            card
                icone "🛡️"
                tag "SEGURANÇA"
                titulo "Proteções por Padrão"
                texto "Senhas com hash, proteção CSRF nos formulários e permissões verificadas no servidor. Runtime em Go, com SQLite embutido e sem CGO."
                link "/docs"

    secao "Uma Linguagem. Todo o Software."
        subtitulo "Trechos de um mesmo programa, verificado com ge check."
        grade 3 colunas
            card
                icone "🗄️"
                titulo "1. O que existe"
                texto "Dados e campos em palavras do domínio. As tabelas e as migrações são derivadas."
                code "tarefas\n    tem\n        titulo obrigatório\n        descrição\n\n    pertence a\n        usuario"
            card
                icone "⚙️"
                titulo "2. Quem pode e o que acontece"
                texto "Estados, ações e permissões declarados; o servidor os aplica em toda operação."
                code "tarefas\n    começa aberta\n\n    pode\n        concluir\n        reabrir\n\n    acesso\n        usuario\n            criar seus\n            ver seus\n            concluir seus"
            card
                icone "🖥️"
                titulo "3. O que aparece"
                texto "Páginas declaradas. Formulários e botões aparecem só para quem o backend permite."
                code "página Tarefas\n    mostre tarefas\n    permita\n        criar\n        editar"

    rodape
        copyright "Germanio © 2026 — Desenvolvido por Flávio Kalleu e contribuidores."
        link "GitHub" "https://github.com/flaviokalleu/germanio"
        link "Docs" "/docs"
        link "Exemplos" "/exemplos"
        link "Instalar" "/instalar"
