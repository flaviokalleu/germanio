pagina "/blog"
    titulo "Blog & Changelog — Germanio"

    navbar
        logo "/assets/germanio.png" "Germanio"
        link "Início" "/"
        link "Documentação" "/docs"
        link "Exemplos" "/exemplos"
        botao "Instalar" "/instalar"

    hero
        badge "CHANGELOG & NOTAS DE VERSÃO"
        titulo "Evolução Contínua da Linguagem."
        descricao "As versões marcadas no repositório e o que está em desenvolvimento. Ainda não há uma versão 1.0."
        botao primario "Ver os commits" "https://github.com/flaviokalleu/germanio/commits/master"
        botao secundario "Ver as tags" "https://github.com/flaviokalleu/germanio/tags"

    secao "Histórico de Versões"
        subtitulo "Tags existentes: v0.2.0, v0.5.0, v0.5.1 e v0.6.0."
        grade 3 colunas
            card
                icone "🚧"
                tag "0.7.0-dev · SEM RELEASE"
                titulo "Camada de Intenção"
                texto "Em desenvolvimento no master: a camada de intenção (tem, acesso, pode, página), o ge fmt e a reimplementação do GitLab FOSS em .ge."
            card
                icone "⚡"
                tag "v0.6.0"
                titulo "IDE Web e Integrações"
                texto "Marcada em 11/04/2026: editor web com pré-visualização, desfazer e refazer, e funções de integração."
            card
                icone "🔷"
                tag "v0.5.0 · v0.5.1"
                titulo "Correções"
                texto "Marcadas em 10/04/2026: referências de versão atualizadas e navegação da barra lateral corrigida."

    rodape
        copyright "Germanio © 2026 — Blog e Changelog."
        link "GitHub" "https://github.com/flaviokalleu/germanio"
        link "Início" "/"
