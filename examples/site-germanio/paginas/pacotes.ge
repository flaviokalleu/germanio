pagina "/pacotes"
    titulo "Pacotes — Germanio"

    navbar
        logo "/assets/germanio.png" "Germanio"
        link "Início" "/"
        link "Documentação" "/docs"
        link "Roadmap" "/roadmap"
        botao "Instalar" "/instalar"

    hero
        badge "MÓDULOS E IMPORTAÇÃO"
        titulo "Organize o Projeto em Arquivos."
        descricao "Divida o projeto em arquivos e pastas com importar. Um gerenciador de pacotes ainda não existe: está planejado."
        botao primario "Ver Roadmap" "/roadmap"
        botao secundario "Documentação" "/docs"
        codigo "app.ge" "crie sistema Loja\n\nimportar \"backend\"\nimportar \"frontend\""

    secao "Reutilização de Código"
        subtitulo "Como estruturar projetos hoje."
        grade 3 colunas
            card
                icone "📦"
                titulo "Importação de Pastas"
                texto "importar \"backend\" traz todos os .ge da pasta, em ordem alfabética: um arquivo novo entra no sistema sem registro manual."
            card
                icone "🔗"
                titulo "Importação por Nome"
                texto "Cada arquivo do frontend diz o que usa do backend; o ge check confere que isso existe."
                code "importar produtos e pedidos do backend"
            card
                icone "🗓️"
                titulo "Planejado: ge adicionar"
                texto "Um gerenciador de pacotes com versões e lockfile está planejado. Ainda não há código."

    rodape
        copyright "Germanio © 2026 — Pacotes e Módulos."
        link "GitHub" "https://github.com/flaviokalleu/germanio"
        link "Início" "/"
