pagina "/comunidade"
    titulo "Comunidade — Germanio"

    navbar
        logo "/assets/germanio.png" "Germanio"
        link "Início" "/"
        link "Documentação" "/docs"
        link "Exemplos" "/exemplos"
        link "Blog" "/blog"
        botao "Instalar" "/instalar"

    hero
        badge "COMUNIDADE E CÓDIGO ABERTO"
        titulo "Construído em Público, para Desenvolvedores."
        descricao "Acompanhe o desenvolvimento, relate problemas e proponha mudanças pelas Issues do GitHub."
        botao primario "Acessar Repositório GitHub" "https://github.com/flaviokalleu/germanio"
        botao secundario "Abrir uma Issue" "https://github.com/flaviokalleu/germanio/issues"

    secao "Canais e Recursos"
        subtitulo "Onde acompanhar o progresso e colaborar."
        grade 3 colunas
            card
                icone "🐙"
                tag "GITHUB"
                titulo "Repositório Principal"
                texto "Código aberto do compilador, do runtime, da CLI e dos exemplos."
                link "https://github.com/flaviokalleu/germanio"
            card
                icone "💬"
                tag "ISSUES"
                titulo "Problemas e Propostas"
                texto "Relatos de erro e propostas de mudança na linguagem são feitos pelas Issues."
                link "https://github.com/flaviokalleu/germanio/issues"
            card
                icone "🧩"
                tag "VS CODE"
                titulo "Extensão para VS Code"
                texto "Realce de sintaxe para arquivos .ge no VS Code."
                link "https://github.com/flaviokalleu/germanio/tree/master/vscode-germanio"

    rodape
        copyright "Germanio © 2026 — Comunidade Open Source."
        link "GitHub" "https://github.com/flaviokalleu/germanio"
        link "Início" "/"
