  secao "Próximos Marcos de Desenvolvimento"
    subtitulo "Recursos planejados para o ecossistema Germanio."
    grade 3 colunas
      card
        icone "📦"
        tag "EM ANDAMENTO"
        titulo "Gerenciador de Pacotes"
        texto "Comando 'ge adicionar' para inclusão de bibliotecas de terceiros com checagem de hash e resolução de dependências."
      card
        icone "🔍"
        tag "PLANEJADO"
        titulo "LSP & Formatter Canônico"
        texto "Servidor LSP para autocompletion completo no VS Code/Neovim e comando nativo 'ge fmt'."
      card
        icone "⚡"
        tag "PLANEJADO"
        titulo "Playground WASM"
        texto "Compilação do core Germanio para WebAssembly para execução client-side sem necessidade de backend."

