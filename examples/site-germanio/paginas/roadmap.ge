pagina "/roadmap"
    titulo "Roadmap — Germanio"

    navbar
        logo "/assets/germanio.png" "Germanio"
        link "Início" "/"
        link "Documentação" "/docs"
        link "Exemplos" "/exemplos"
        link "Comunidade" "/comunidade"
        botao "Instalar" "/instalar"

    hero
        badge "PLANEJAMENTO TÉCNICO"
        titulo "Metas e Próximos Passos."
        descricao "Prioridades do projeto: correção, segurança, desempenho medido e ergonomia. As lacunas conhecidas estão em GERMANIO_GAPS.md, no repositório."
        botao primario "Contribuir no GitHub" "https://github.com/flaviokalleu/germanio"
        botao secundario "Ver as lacunas" "https://github.com/flaviokalleu/germanio/blob/master/GERMANIO_GAPS.md"

    secao "Próximos Marcos de Desenvolvimento"
        subtitulo "Recursos planejados; nenhum deles existe ainda."
        grade 3 colunas
            card
                icone "📦"
                tag "PLANEJADO"
                titulo "Gerenciador de Pacotes"
                texto "Comando ge adicionar para incluir bibliotecas de terceiros, com verificação de hash e resolução de dependências."
            card
                icone "🔍"
                tag "PLANEJADO"
                titulo "Servidor de Linguagem (LSP)"
                texto "Autocompletar e diagnósticos no VS Code e no Neovim. O formatador já existe: ge fmt."
            card
                icone "⚡"
                tag "PLANEJADO"
                titulo "Playground no Navegador"
                texto "Compilar o core para WebAssembly e rodar exemplos no navegador, sem backend."

    rodape
        copyright "Germanio © 2026 — Roadmap."
        link "GitHub" "https://github.com/flaviokalleu/germanio"
        link "Início" "/"
