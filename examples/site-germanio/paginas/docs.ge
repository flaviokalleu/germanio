pagina "/docs"
    titulo "Documentação — Germanio"

    navbar
        logo "/assets/germanio.png" "Germanio"
        link "Início" "/"
        link "Documentação" "/docs"
        link "Exemplos" "/exemplos"
        link "Aprender" "/aprender"
        botao "Instalar" "/instalar"

    hero
        badge "DOCUMENTAÇÃO"
        titulo "Aprenda a Linguagem e a CLI."
        descricao "Visão geral da camada de intenção e dos comandos da CLI ge. A especificação normativa é o arquivo docs/INTENCAO.md, no repositório."
        botao primario "Guia Passo a Passo" "/aprender"
        botao secundario "Ler a especificação" "https://github.com/flaviokalleu/germanio/blob/master/docs/INTENCAO.md"
        codigo "backend/produtos.ge" "produtos\n    tem\n        nome obrigatório\n        descrição formatada\n        preco obrigatório\n        estoque começa com 0\n\n    acesso\n        todos\n            ver\n        somente administrador\n            criar\n            editar\n            excluir\n\n    permita\n        pesquisar por nome"

    secao "Comandos da CLI ge"
        subtitulo "Ferramentas para escrever, verificar e rodar um programa."
        grade 4 colunas
            card
                icone "⚡"
                titulo "ge check"
                texto "Verifica o programa sem executá-lo e mostra os erros com a linha em que estão."
            card
                icone "▶️"
                titulo "ge rodar"
                texto "Verifica e executa a aplicação, com banco e servidor web (porta padrão 8080)."
            card
                icone "📁"
                titulo "ge init"
                texto "Cria um projeto novo, guiado passo a passo."
            card
                icone "✨"
                titulo "ge fmt"
                texto "Formata os arquivos .ge na forma canônica; com --check, só confere."

    secao "Conceitos Fundamentais"
        subtitulo "As quatro perguntas que todo programa Germanio responde."
        grade 2 colunas
            card
                icone "🗃️"
                titulo "1. O que existe"
                texto "Cada dado diz o que tem. O banco e as migrações são derivados do que você declara."
                code "clientes\n    tem\n        nome obrigatório\n        email obrigatório e único\n        telefone"
            card
                icone "🔐"
                titulo "2. Quem pode fazer o quê"
                texto "Sob acesso ficam as pessoas e o que cada uma pode fazer. O servidor confere em toda operação."
                code "produtos\n    acesso\n        todos\n            ver\n        somente administrador\n            criar\n            editar\n            excluir"
            card
                icone "⚡"
                titulo "3. O que acontece"
                texto "Estados e ações com significado: a tarefa começa aberta e pode ser concluída ou reaberta."
                code "tarefas\n    começa aberta\n\n    pode\n        concluir\n        reabrir\n\n    acesso\n        usuario\n            criar seus\n            ver seus\n            concluir seus"
            card
                icone "📄"
                titulo "4. O que aparece"
                texto "A página diz o que mostra e o que permite; quem pode cada ação é decidido pelo backend."
                code "página Tarefas\n    mostre tarefas\n    permita\n        criar\n        editar"

    rodape
        copyright "Germanio © 2026 — Documentação."
        link "GitHub" "https://github.com/flaviokalleu/germanio"
        link "Início" "/"
        link "Exemplos" "/exemplos"
