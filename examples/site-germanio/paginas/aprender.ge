pagina "/aprender"
    titulo "Aprenda Germanio — Guia Passo a Passo"

    navbar
        logo "/assets/germanio.png" "Germanio"
        link "Início" "/"
        link "Documentação" "/docs"
        link "Exemplos" "/exemplos"
        link "Experimentar" "/playground"
        botao "Instalar" "/instalar"

    hero
        badge "TRILHA DE APRENDIZADO"
        titulo "Aprenda Germanio em 4 Passos."
        descricao "Do primeiro dado até uma aplicação com login, permissões e páginas, sem escrever rotas, SQL ou HTML."
        botao primario "Iniciar com Germanio →" "/docs"
        botao secundario "Ver Exemplos" "/exemplos"

    secao "Passo a Passo"
        subtitulo "Os trechos são partes de um mesmo programa, verificado com ge check."
        grade 2 colunas
            card
                icone "1️⃣"
                tag "PASSO 1"
                titulo "1. Crie o sistema"
                texto "Todo programa começa dizendo o nome do sistema. O banco SQLite já vem embutido."
                code "crie sistema Tarefas"
            card
                icone "2️⃣"
                tag "PASSO 2"
                titulo "2. Diga o que existe"
                texto "Cada dado lista o que tem e a quem pertence, em palavras do domínio."
                code "tarefas\n    tem\n        titulo obrigatório\n        descrição\n\n    pertence a\n        usuario"
            card
                icone "3️⃣"
                tag "PASSO 3"
                titulo "3. Diga quem pode"
                texto "Ligue o login e diga o que cada pessoa pode fazer. 'seus' limita aos próprios registros."
                code "tenha login\nlogin usa email\n\ntarefas\n    acesso\n        usuario\n            criar seus\n            ver seus"
            card
                icone "4️⃣"
                tag "PASSO 4"
                titulo "4. Diga o que aparece"
                texto "Declare a página: o que ela mostra e o que permite fazer."
                code "página Tarefas\n    mostre tarefas\n    permita\n        criar\n        editar"

    rodape
        copyright "Germanio © 2026 — Guia."
        link "GitHub" "https://github.com/flaviokalleu/germanio"
        link "Início" "/"
        link "Documentação" "/docs"
