pagina "/instalar"
    titulo "Instalar o Germanio — Linux, macOS e Windows"

    navbar
        logo "/assets/germanio.png" "Germanio"
        link "Início" "/"
        link "Documentação" "/docs"
        link "Exemplos" "/exemplos"
        link "Aprender" "/aprender"

    hero
        badge "INSTALAÇÃO"
        titulo "Obtenha a CLI ge."
        descricao "A instalação compila a CLI a partir do código-fonte. Requisitos: git e Go 1.26 ou mais recente."
        botao primario "Ver Documentação" "/docs"
        botao secundario "Ver no GitHub" "https://github.com/flaviokalleu/germanio"
        comando "go install github.com/flaviokalleu/germanio/cmd/ge@master"

    secao "Métodos de Instalação"
        subtitulo "Ainda não há binários pré-compilados; os dois métodos compilam com Go."
        grade 3 colunas
            card
                icone "🐧"
                tag "LINUX E MACOS"
                titulo "1. Script de instalação"
                texto "Clona o repositório em ~/.germanio, compila ge e germanio com Go e os coloca em ~/.local/bin."
                code "curl -fsSL https://raw.githubusercontent.com/flaviokalleu/germanio/main/install.sh | bash"
            card
                icone "🐹"
                tag "QUALQUER SISTEMA COM GO"
                titulo "2. Compilação via Go"
                texto "Use @master: a última tag (v0.6.0) ainda não contém a CLI ge. Ou clone e compile com go build -o ge ./cmd/ge."
                code "go install github.com/flaviokalleu/germanio/cmd/ge@master"
            card
                icone "✅"
                tag "VERIFICAÇÃO"
                titulo "3. Validação"
                texto "Confirme que a CLI está no PATH e veja a versão instalada."
                code "ge versao\nge ajuda"

    rodape
        copyright "Germanio © 2026 — Guia de Instalação."
        link "GitHub" "https://github.com/flaviokalleu/germanio"
        link "Início" "/"
