pagina "/playground"
    titulo "Experimentar — Germanio"

    navbar
        logo "/assets/germanio.png" "Germanio"
        link "Início" "/"
        link "Documentação" "/docs"
        link "Exemplos" "/exemplos"
        botao "Instalar" "/instalar"

    hero
        badge "GUIA · SEM PLAYGROUND ONLINE"
        titulo "Experimente Germanio na sua máquina."
        descricao "Ainda não há um playground interativo no navegador. Este guia mostra como escrever, verificar e rodar um programa localmente."
        botao primario "Instalar a CLI" "/instalar"
        botao secundario "Documentação" "/docs"
        codigo "clientes.ge" "crie sistema Clientes\n\nclientes\n    tem\n        nome obrigatório\n        email obrigatório e único\n        telefone\n\n    permita\n        pesquisar\n\npágina Clientes\n    mostre clientes\n    permita\n        cadastrar\n        editar\n        excluir"

    secao "Como Experimentar"
        subtitulo "Salve o programa ao lado como clientes.ge e siga os passos."
        grade 3 colunas
            card
                icone "💻"
                titulo "1. Instale a CLI ge"
                texto "Pelo script (Linux e macOS) ou com go install, em qualquer sistema com Go."
                link "/instalar"
            card
                icone "⚡"
                titulo "2. Verifique com ge check"
                texto "Confere o programa sem executá-lo e mostra os erros com a linha em que estão."
                code "ge check clientes.ge"
            card
                icone "🚀"
                titulo "3. Execute com ge rodar"
                texto "O servidor sobe na porta 8080, com o banco SQLite embutido. Abra http://localhost:8080."
                code "ge rodar clientes.ge"

    rodape
        copyright "Germanio © 2026 — Guia para experimentar."
        link "GitHub" "https://github.com/flaviokalleu/germanio"
        link "Início" "/"
