# nulo só pertence a um tipo opcional, inclusive dentro de listas.
nomes: [texto?] = [nulo, "Ada"]
mostre nomes[0] == nulo
mostre nomes[1]

tem_nome(valor: texto?) -> bool
  valor != nulo

mostre tem_nome(nomes[1])

saudar(valor: texto?) -> texto
  se valor == nulo ou quantidade(valor) == 0
    retorne "sem nome"
  retorne "Olá " + valor

mostre saudar(nomes[0])
mostre saudar(nomes[1])
mostre saudar("")
