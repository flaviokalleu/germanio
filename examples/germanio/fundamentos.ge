somar(a, b)
  a + b

dobro(x) = x * 2

variavel contador = 0
enquanto contador < 3
  contador += 1

valores: [inteiro] = [1, 2, 3]
variavel total = 0
para valor em valores
  total += valor

se total == 6
  mostre "Total correto: {total}"
senao
  mostre "Total inesperado"

variavel telefone: texto? = nulo
mostre telefone == nulo
telefone = "61 99999-9999"
se telefone != nulo
  mostre telefone + " confirmado"
  telefone = nulo
mostre telefone == nulo
mostre somar(contador, total)
mostre dobro(valores[1])
mostre numero("5") + 2
