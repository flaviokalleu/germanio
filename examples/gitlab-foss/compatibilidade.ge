# Compatibilidade com a API v4 do GitLab: apenas nomes externos.
# O domínio continua em português; clientes GitLab veem os nomes originais.

integração em "/api/v4"
mensagens em inglês

vocabulário da integração
    nome é "name"
    caminho é "path"
    caminho_completo é "full_path"
    descricao é "description"
    visibilidade é "visibility"
    branch_padrao é "default_branch"
    arquivado é "archived"
    grupo_id é "namespace_id"
    pai_id é "parent_id"
    criador_id é "creator_id"
    pessoa_id é "user_id"
    papel é "access_level"
    pode_criar_grupos é "can_create_group"
    estado é "state"
    ativo é "active"
    bloqueado é "blocked"
    bloquear é "block"
    desbloquear é "unblock"
    escopos é "scopes"
    expira_em é "expires_at"
    revogado é "revoked"
    revogar é "revoke"
    numero é "iid"
    titulo é "title"
    texto é "body"
    cor é "color"
    aberta é "opened"
    fechada é "closed"
    fechada_em é "closed_at"
    fechada_por_id é "closed_by_id"
    autor_id é "author_id"
    confidencial é "confidential"
    responsaveis é "assignee_ids"
    fechar é "close"
    reabrir é "reopen"
