# Compatibilidade com a API v4 do GitLab: apenas nomes externos.
# O domínio continua em português; clientes GitLab veem os nomes originais.

integração em "/api/v4"
mensagens em inglês

vocabulário da integração
    nome é "name"
    caminho é "path"
    caminho_completo é "full_path"
    descricao é "description"
    visibilidade é "visibility"
    branch_padrao é "default_branch"
    arquivado é "archived"
    grupo_id é "namespace_id"
    pai_id é "parent_id"
    criador_id é "creator_id"
    pessoa_id é "user_id"
    papel é "access_level"
    pode_criar_grupos é "can_create_group"
    estado é "state"
    ativo é "active"
    bloqueado é "blocked"
    bloquear é "block"
    desbloquear é "unblock"
    escopos é "scopes"
    expira_em é "expires_at"
    revogado é "revoked"
    revogar é "revoke"
    numero é "iid"
    titulo é "title"
    texto é "body"
    cor é "color"
    aberta é "opened"
    fechada é "closed"
    fechada_em é "closed_at"
    fechada_por_id é "closed_by_id"
    autor_id é "author_id"
    confidencial é "confidential"
    responsaveis é "assignee_ids"
    fechar é "close"
    reabrir é "reopen"
    origem é "source_branch"
    destino é "target_branch"
    aberto é "opened"
    fechado é "closed"
    mesclado é "merged"
    mesclado_em é "merged_at"
    mesclado_por_id é "merged_by_id"
    fechado_em é "closed_at"
    fechado_por_id é "closed_by_id"
    mesclar é "merge"
    aprovar é "approve"
    desaprovar é "unapprove"
    aprovacoes é "approved_by_ids"
    revisores é "reviewer_ids"
    rascunho é "draft"
    mudancas é "changes"
    pode_mesclar é "can_be_merged"
    conflitos é "conflicts"
    commit_mesclagem é "merge_commit_sha"
