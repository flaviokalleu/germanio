# Regras específicas do GitLab (lógica explícita, último recurso).

logica
  definir FORMATO_CAMINHO = "^[a-zA-Z0-9_.][a-zA-Z0-9_.-]*[a-zA-Z0-9_-]$|^[a-zA-Z0-9_]$"
  definir RESERVADOS = ["-", "admin", "api", "assets", "dashboard", "explore", "groups", "help", "oauth", "projects", "public", "search", "uploads", "users"]

  funcao caminho_de_projeto(caminho)
    retornar tamanho(caminho) <= 255 e regex.casa(FORMATO_CAMINHO, caminho) e nao termina_com(caminho, ".git") e nao termina_com(caminho, ".atom")

  # Nomes reservados valem para usuários e grupos (primeiro nível da URL).
  funcao caminho_valido(caminho)
    retornar caminho_de_projeto(caminho) e nao contem(RESERVADOS, minusculo(caminho))

# O endereço de um grupo inclui o do grupo pai.
antes de criar grupo
    dados.caminho_completo = dados.caminho
    se dados.pai_id != nulo
        dados.caminho_completo = grupo.buscar(dados.pai_id).caminho_completo + "/" + dados.caminho
    se usuario.existe({username: dados.caminho_completo})
        recuse "Path has already been taken"

quando criar grupo
    membro.criar({recurso: "grupo", recurso_id: grupo.id, pessoa_id: atual.id, papel: "owner"})

# Projeto pessoal fica no endereço do usuário; projeto de grupo, no do grupo.
antes de criar projeto
    se dados.grupo_id == nulo
        dados.caminho_completo = atual.username + "/" + dados.caminho
    senao
        dados.caminho_completo = grupo.buscar(dados.grupo_id).caminho_completo + "/" + dados.caminho
    se grupo.existe({caminho_completo: dados.caminho_completo})
        recuse "Path has already been taken"

quando criar projeto
    se projeto.grupo_id == nulo
        membro.criar({recurso: "projeto", recurso_id: projeto.id, pessoa_id: atual.id, papel: "owner"})
    se obter(entrada, "initialize_with_readme", falso) == verdadeiro
        git.commitar(projeto.repositorio, {branch: projeto.branch_padrao, mensagem: "Initial commit", autor: {nome: atual.nome, email: atual.email}, acoes: [{acao: "criar", caminho: "README.md", conteudo: "# " + projeto.nome + "\n"}]})

# O grupo precisa manter pelo menos um owner.
antes de excluir membro
    se membro.papel == "owner" e membro.contar({recurso: membro.recurso, recurso_id: membro.recurso_id, papel: "owner"}) == 1
        recuse "The last owner cannot leave or be removed"
