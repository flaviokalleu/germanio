# Pessoas e tokens de acesso.

tenha usuarios
tenha tokens de acesso

usuario tem
    username obrigatório e único valida caminho_valido
    email obrigatório, único e privado
    nome obrigatório
    senha min 8 max 128
    admin começa com falso
    pode_criar_grupos começa com verdadeiro

usuario começa ativo

usuario pode
    bloquear
    desbloquear

token de acesso tem
    nome obrigatório
    token segredo prefixo "glpat-"
    escopos começa com "api"
    expira em 365 dias
    revogavel

token de acesso pertence a usuario

tenha login
tenha cadastro
login usa username e email
login exige estado "ativo"
login bloqueia após 10 tentativas por 10 minutos
login aceita tokens de acesso no cabeçalho "PRIVATE-TOKEN"
login aceita oauth por 2 horas

todos podem ver usuarios

usuario pode
    editar seu perfil
    criar tokens de acesso
    ver seus tokens de acesso
    revogar seus tokens de acesso

somente administrador pode
    criar usuarios
    excluir usuarios
    bloquear usuarios
    desbloquear usuarios

disponibilize para integração
    usuarios como "users"
    tokens de acesso como "personal_access_tokens"

ao iniciar
    se usuario.contar() == 0 e ambiente.ler("GITLAB_ROOT_PASSWORD", nulo) != nulo
        usuario.criar({username: "root", email: "admin@example.com", nome: "Administrator", senha: ambiente.ler("GITLAB_ROOT_PASSWORD"), admin: verdadeiro})
