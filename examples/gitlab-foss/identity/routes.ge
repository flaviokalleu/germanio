# Registro, login, OAuth password grant, usuário atual e tokens pessoais.

rotas
  # RegistrationsController#create (formulário web)
  rota POST "/users"
    definir f = requisicao.corpo
    definir dados = {username: obter(f, "user[username]", nulo), email: obter(f, "user[email]", nulo), name: obter(f, "user[name]", nulo), password: obter(f, "user[password]", nulo)}
    se dados.name == nulo
      dados.name = cortar(texto(obter(f, "user[first_name]", "")) + " " + texto(obter(f, "user[last_name]", "")))
    definir u = criar_usuario(dados, falso)
    sessao.iniciar({usuario_id: u.id})
    redirecionar("/")

  # SessionsController#create
  rota POST "/users/sign_in"
    definir f = requisicao.corpo
    definir u = autenticar_senha(obter(f, "user[login]", ""), texto(obter(f, "user[password]", "")))
    se u == nulo
      redirecionar("/users/sign_in?erro=credenciais")
    sessao.iniciar({usuario_id: u.id})
    redirecionar("/")

  rota POST "/users/sign_out"
    sessao.encerrar()
    redirecionar("/users/sign_in")

  # Doorkeeper: grant_type=password → token de acesso OAuth (2 horas)
  rota POST "/oauth/token"
    definir f = requisicao.corpo
    se f == nulo ou obter(f, "grant_type", "") != "password"
      responder(400, {error: "unsupported_grant_type", error_description: "The authorization grant type is not supported by the authorization server."})
    definir u = autenticar_senha(obter(f, "username", ""), texto(obter(f, "password", "")))
    se u == nulo
      responder(400, {error: "invalid_grant", error_description: "The provided authorization grant is invalid, expired, revoked, does not match the redirection URI used in the authorization request, or was issued to another client."})
    definir t = token.assinar({tipo: "oauth", usuario_id: u.id}, 7200)
    retornar {access_token: t, token_type: "Bearer", expires_in: 7200, scope: "api", created_at: agora_iso()}

  rota GET "/api/v4/user"
    definir u = exigir_usuario(requisicao)
    exigir_escopo(requisicao, "read_user")
    retornar apresentar_usuario(u, verdadeiro)

  rota GET "/api/v4/users"
    definir eu = leitor(requisicao)
    definir filtros = {}
    se requisicao.consulta.username != nulo
      filtros.username = requisicao.consulta.username
    se requisicao.consulta.search != nulo
      filtros.username__contem = requisicao.consulta.search
    definir r = usuario.paginar(filtros, opcoes_paginacao(requisicao, "id"))
    definir itens = []
    para cada u em r.itens
      itens = adicionar(itens, apresentar_usuario(u, eu != nulo e eu.admin))
    responder_pagina(r, itens)

  rota GET "/api/v4/users/:id"
    definir eu = leitor(requisicao)
    definir u = usuario.buscar(requisicao.parametros.id)
    se u == nulo
      falhar(404, "404 User Not Found")
    retornar apresentar_usuario(u, eu != nulo e (eu.admin ou eu.id == u.id))

  # Users API (admin) — POST /users
  rota POST "/api/v4/users"
    exigir_admin(requisicao)
    definir c = requisicao.corpo
    definir u = criar_usuario(c, obter(c, "admin", falso) == verdadeiro)
    responder(201, apresentar_usuario(u, verdadeiro))

  rota POST "/api/v4/users/:id/block"
    exigir_admin(requisicao)
    definir u = usuario.buscar(requisicao.parametros.id)
    se u == nulo
      falhar(404, "404 User Not Found")
    usuario.atualizar(u.id, {state: "blocked"})
    responder(201, verdadeiro)

  rota POST "/api/v4/users/:id/unblock"
    exigir_admin(requisicao)
    definir u = usuario.buscar(requisicao.parametros.id)
    se u == nulo
      falhar(404, "404 User Not Found")
    usuario.atualizar(u.id, {state: "active"})
    responder(201, verdadeiro)

  rota POST "/api/v4/user/personal_access_tokens"
    definir u = escritor(requisicao)
    responder(201, criar_token(u, requisicao.corpo))

  rota POST "/api/v4/users/:id/personal_access_tokens"
    exigir_admin(requisicao)
    definir u = usuario.buscar(requisicao.parametros.id)
    se u == nulo
      falhar(404, "404 User Not Found")
    responder(201, criar_token(u, requisicao.corpo))

  rota GET "/api/v4/personal_access_tokens"
    definir u = exigir_usuario(requisicao)
    definir itens = []
    para cada t em token_acesso.filtrar({usuario_id: u.id}, {ordenar: "id"})
      itens = adicionar(itens, apresentar_token(t))
    retornar itens

  rota DELETE "/api/v4/personal_access_tokens/:id"
    definir u = escritor(requisicao)
    definir t = token_acesso.buscar(requisicao.parametros.id)
    se t == nulo ou (t.usuario_id != u.id e nao u.admin)
      falhar(404, "404 Not Found")
    token_acesso.atualizar(t.id, {revoked: verdadeiro})
    responder(204, nulo)
