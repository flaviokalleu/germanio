# Pessoas e tokens de acesso.

usuarios
    tem
        username obrigatório e único
        email obrigatório, único e privado
        nome obrigatório
        senha min 8 max 128
        admin começa com falso

    começa ativo

    pode
        bloquear
        desbloquear

    acesso
        todos
            ver
        usuario
            editar seu perfil
        somente administrador
            criar
            excluir
            bloquear
            desbloquear

    integração
        nome "users"

tokens de acesso
    singular token de acesso

    tem
        nome obrigatório
        token segredo prefixo "glpat-"
        escopos começa com "api"
        expira em 365 dias
        revogavel

    pertence a
        usuario

    acesso
        usuario
            criar
            ver seus
            revogar seus

    integração
        nome "personal_access_tokens"

tenha login
tenha cadastro
tenha administrador inicial "root"
login usa username e email
login exige estado "ativo"
login bloqueia após 10 tentativas por 10 minutos

escopo "api" permite tudo
escopo "read_api" permite ler
escopo "read_user" permite ler
escopo "read_repository" permite baixar código
escopo "write_repository" permite baixar código e enviar código
