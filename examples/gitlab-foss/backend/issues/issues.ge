# Issues: o que são, quem pode fazer o quê, como aparecem para integrações.

projetos
    tem
        issues
        labels

issues
    tem
        numero por projeto
        titulo obrigatório até 255
        descrição formatada
        autor
        labels por nome
        responsaveis
        comentarios
        peso inteiro min 0
        estimativa inteiro min 0
        tempos gastos
        ligacoes

    começa aberta

    pode
        fechar
        reabrir
        ser confidencial
        mudar de projeto

    pendência para
        responsaveis
        mencionados

    guarda histórico

    regras
        confidencial pode ser vista por
            autor
            responsaveis
            reporter ou superior

    acesso
        usuario
            criar
            comentar
        guest
            ver
        autor ou planner
            editar
            fechar
            reabrir
        somente maintainer
            excluir

    permita
        pesquisar
        filtrar por estado, autor, labels, responsaveis, milestone e peso

    integração

# Controle de tempo: quanto se estima (em segundos) e cada tempo gasto
# registrado por alguém, que pode ser negativo para descontar.
tempos gastos
    singular tempo gasto

    tem
        duracao inteiro obrigatório
        descrição
        autor

    acesso
        planner
            criar

# Ligações: uma issue relacionada a outra, de qualquer projeto. Só quem vê
# as duas vê a ligação; ela sai com qualquer uma delas.
ligacoes
    singular ligacao

    pertence a
        issue como relacionada

    acesso
        guest
            criar
            excluir

    permita
        filtrar por relacionada

    integração

comentarios
    tem
        autor
        texto obrigatório e formatado

    pendência para
        mencionados

    integração
        nome "notes"

labels
    tem
        nome obrigatório
        cor padrão "#6699cc"
        descrição

    acesso
        guest
            ver
        reporter
            administrar

    integração
