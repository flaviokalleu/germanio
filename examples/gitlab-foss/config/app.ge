# Configuração global da instância (equivalente a gitlab.yml / ApplicationSetting).

logica
  definir URL_BASE = ambiente.ler("GITLAB_URL", "http://localhost:8080")

  # Gitlab::Access — níveis de acesso de membros
  definir NIVEL = {sem_acesso: 0, guest: 10, planner: 15, reporter: 20, developer: 30, maintainer: 40, owner: 50, admin: 60}
  definir NOME_NIVEL = {"10": "Guest", "15": "Planner", "20": "Reporter", "30": "Developer", "40": "Maintainer", "50": "Owner"}

  # Gitlab::VisibilityLevel
  definir VISIBILIDADE = {private: 0, internal: 10, public: 20}
  definir NOME_VISIBILIDADE = {"0": "private", "10": "internal", "20": "public"}

  # Namespace/Project path rules (Gitlab::PathRegex)
  definir REGEX_CAMINHO = "^[a-zA-Z0-9_.][a-zA-Z0-9_.-]*[a-zA-Z0-9_-]$|^[a-zA-Z0-9_]$"
  definir CAMINHOS_RESERVADOS = ["-", ".well-known", "404.html", "500.html", "admin", "api", "assets", "dashboard", "explore", "groups", "help", "oauth", "profile", "projects", "public", "robots.txt", "s", "search", "sitemap", "uploads", "users", "user_settings"]

  definir SENHA_MINIMA = 8
  definir TENTATIVAS_MAXIMAS = 10

  funcao nome_visibilidade(nivel)
    retornar obter(NOME_VISIBILIDADE, texto(inteiro(nivel)), "private")

  funcao nivel_visibilidade(nome)
    se nome == nulo
      retornar nulo
    se nao tem(VISIBILIDADE, nome)
      falhar(400, {visibility: ["does not have a valid value"]})
    retornar obter(VISIBILIDADE, nome)

  # Mensagens de validação no formato da API do GitLab: {"message": {"campo": ["erro"]}}
  funcao erro_validacao(campo, mensagem)
    definir m = {}
    m[campo] = [mensagem]
    falhar(400, m)

  funcao caminho_valido(caminho)
    se caminho == nulo ou tamanho(caminho) > 255
      retornar falso
    se nao regex.casa(REGEX_CAMINHO, caminho)
      retornar falso
    se termina_com(caminho, ".git") ou termina_com(caminho, ".atom")
      retornar falso
    retornar indice_de(CAMINHOS_RESERVADOS, minusculo(caminho)) < 0

  # Converte "Meu Projeto" em "meu-projeto" (Project#path a partir do nome)
  funcao caminho_de_nome(nome)
    definir c = minusculo(cortar(nome))
    definir c = regex.substituir("[^a-z0-9_.-]+", c, "-")
    definir c = regex.substituir("^[-.]+|[-.]+$", c, "")
    retornar c

  # Paginação padrão da API (page/per_page e cabeçalhos X-*)
  funcao opcoes_paginacao(requisicao, ordenar)
    definir pagina = inteiro(obter(requisicao.consulta, "page", "1"))
    definir por_pagina = inteiro(obter(requisicao.consulta, "per_page", "20"))
    se pagina < 1
      definir pagina = 1
    se por_pagina < 1 ou por_pagina > 100
      definir por_pagina = 20
    retornar {pagina: pagina, limite: por_pagina, ordenar: ordenar}

  funcao responder_pagina(resultado, itens)
    definir cab = {"X-Total": texto(resultado.total), "X-Page": texto(resultado.pagina), "X-Per-Page": texto(resultado.limite)}
    responder(200, itens, cab)
