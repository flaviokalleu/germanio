# NÍVEL AVANÇADO / ADAPTADOR DE COMPATIBILIDADE
#
# Partes da API v4 do GitLab que têm outro formato que a superfície gerada:
# o feed de eventos (nomes de ação do GitLab, também como filtro), as
# preferências de notificação, as estatísticas do administrador, os forks de
# um projeto, os projetos marcados por uma pessoa, o merge por PUT e o resumo
# das aprovações de um merge request. Cada rota só traduz e pede à própria
# aplicação (GEP 0033), como a pessoa que chamou: quem pode ver o quê está em
# backend/.

logica
    definir CABECALHOS_DE_PAGINA = ["X-Total", "X-Page", "X-Per-Page", "X-Total-Pages"]

    # Uma resposta recusada volta como veio (404, 403, 401...).
    funcao exigir(r)
        se r.estado >= 300
            responder(r.estado, r.corpo)
        retornar r

    funcao pagina_de(r)
        definir h = {}
        para cada nome em CABECALHOS_DE_PAGINA
            se tem(r.cabecalhos, nome)
                h[nome] = r.cabecalhos[nome]
        retornar h

    # O histórico (GEP 0011) guarda verbos do domínio; o GitLab chama as ações
    # pelo que aconteceu.
    funcao acao_gitlab(acao, tipo)
        se acao == "criar"
            se tipo == "issue" ou tipo == "merge_request"
                retornar "opened"
            se tipo == "comentario"
                retornar "commented on"
            retornar "created"
        definir nomes = {fechar: "closed", reabrir: "reopened", mesclar: "accepted", editar: "updated", excluir: "destroyed", enviar_codigo: "pushed to", aprovar: "approved", desaprovar: "unapproved", mudar: "updated"}
        retornar obter(nomes, acao, acao)

    funcao tipo_gitlab(tipo)
        definir nomes = {issue: "Issue", merge_request: "MergeRequest", comentario: "Note", milestone: "Milestone", projeto: "Project", grupo: "Group", label: "Label"}
        retornar obter(nomes, tipo, tipo)

    funcao tipo_germanio(tipo)
        definir nomes = {issue: "issue", merge_request: "merge_request", note: "comentario", milestone: "milestone", project: "projeto"}
        se tipo == nulo
            retornar nulo
        retornar obter(nomes, minusculo(tipo), tipo)

    funcao evento_gitlab(a)
        definir ev = {id: a.id, action_name: acao_gitlab(a.action_name, a.target_type), target_id: a.target_id, target_type: tipo_gitlab(a.target_type), target_title: a.target_title, author_id: a.author_id, created_at: a.created_at, project_id: nulo}
        se obter(a, "dentro", nulo) == "projeto"
            ev.project_id = a.dentro_id
        retornar ev

    # O filtro action do GitLab, nos verbos que o histórico guarda (uma lista:
    # qualquer um deles). Comentários não guardam histórico nesta aplicação,
    # então "created" são as criações de issues e merge requests; "commented"
    # seria a criação de um comentário. joined, left e expired não acontecem
    # aqui: a lista fica vazia.
    definir ACOES_DO_FILTRO = {created: ["criar"], updated: ["editar", "mudar"], closed: ["fechar"], reopened: ["reabrir"], pushed: ["enviar_codigo"], commented: ["criar"], merged: ["mesclar"], approved: ["aprovar"], destroyed: ["excluir"], joined: [], left: [], expired: []}

    funcao vazio_paginado(requisicao)
        responder(200, [], {"X-Total": "0", "X-Total-Pages": "0", "X-Page": texto(obter(requisicao.consulta, "page", "1")), "X-Per-Page": texto(obter(requisicao.consulta, "per_page", "20"))})

    funcao listar_eventos(consulta, requisicao)
        consulta.page = obter(requisicao.consulta, "page", nulo)
        consulta.per_page = obter(requisicao.consulta, "per_page", nulo)
        consulta.target_type = tipo_germanio(obter(requisicao.consulta, "target_type", nulo))
        definir acao = obter(requisicao.consulta, "action", nulo)
        se acao != nulo
            se nao tem(ACOES_DO_FILTRO, acao)
                responder(400, {message: {action: ["does not have a valid value"]}})
            definir verbos = ACOES_DO_FILTRO[acao]
            se tamanho(verbos) == 0
                vazio_paginado(requisicao)
            consulta.action_name = verbos
            se acao == "commented"
                se consulta.target_type != nulo e consulta.target_type != "comentario"
                    vazio_paginado(requisicao)
                consulta.target_type = "comentario"
        definir r = exigir(superficie.pedir("GET", "historico", nulo, consulta))
        definir lista = []
        para cada at em r.corpo
            lista = adicionar(lista, evento_gitlab(at))
        responder(200, lista, pagina_de(r))

    # Quem aprovou, como o GitLab mostra: só as pessoas que quem pergunta vê.
    funcao aprovadores(ids)
        definir lista = []
        para cada pessoa_id em ids
            definir u = superficie.pedir("GET", ["users", pessoa_id])
            se u.estado == 200
                lista = adicionar(lista, {user: {id: u.corpo.id, username: u.corpo.username, name: obter(u.corpo, "name", nulo), state: obter(u.corpo, "state", nulo), avatar_url: obter(u.corpo, "avatar_url", nulo)}})
        retornar lista

    funcao merge_request_em(requisicao)
        retornar ["projects", requisicao.parametros.id, "merge_requests", requisicao.parametros.iid]

    funcao nivel(pessoa)
        se obter(pessoa, "avisos_por_email", verdadeiro) == falso
            retornar "disabled"
        retornar "participating"

rotas
    rota GET "/api/v4/events"
        listar_eventos({}, requisicao)

    rota GET "/api/v4/projects/:id/events"
        definir p = exigir(superficie.pedir("GET", ["projects", requisicao.parametros.id]))
        listar_eventos({dentro: "projeto", dentro_id: p.corpo.id}, requisicao)

    rota GET "/api/v4/notification_settings"
        definir eu = exigir(superficie.pedir("GET", "user"))
        responder(200, {level: nivel(eu.corpo), notification_email: obter(eu.corpo, "email", nulo)})

    rota PUT "/api/v4/notification_settings"
        definir eu = exigir(superficie.pedir("GET", "user"))
        definir pedido = obter(requisicao.consulta, "level", obter(requisicao.corpo, "level", nulo))
        se pedido != nulo
            se nao contem(["disabled", "participating", "watch", "global", "mention", "custom"], pedido)
                responder(400, {message: {level: ["is not included in the list"]}})
            definir r = exigir(superficie.pedir("PUT", ["users", eu.corpo.id], {avisos_por_email: pedido != "disabled"}))
            eu = r
        responder(200, {level: nivel(eu.corpo), notification_email: obter(eu.corpo, "email", nulo)})

    # Estatísticas da instância: o GitLab só as mostra ao administrador. Os
    # números contam como os indicadores (GEP 0012).
    rota GET "/api/v4/application/statistics"
        se atual == nulo
            responder(401, {message: "401 Unauthorized"})
        se nao acesso.administrador()
            responder(403, {message: "403 Forbidden"})
        responder(200, {users: texto(superficie.contar("usuarios")), active_users: texto(superficie.contar("usuarios", "ativo")), projects: texto(superficie.contar("projetos")), groups: texto(superficie.contar("grupos")), issues: texto(superficie.contar("issues")), merge_requests: texto(superficie.contar("merge_requests")), notes: texto(superficie.contar("comentarios")), milestones: texto(superficie.contar("milestones")), forks: "0", snippets: "0", ssh_keys: "0"})

    # Os forks de um projeto: as cópias dele (GEP 0029) que a pessoa vê, de um
    # projeto que ela vê; com a mesma pesquisa e as mesmas páginas da lista.
    rota GET "/api/v4/projects/:id/forks"
        definir p = exigir(superficie.pedir("GET", ["projects", requisicao.parametros.id]))
        definir consulta = copiar(requisicao.consulta)
        consulta.forked_from_project_id = p.corpo.id
        definir r = exigir(superficie.pedir("GET", "projects", nulo, consulta))
        responder(200, r.corpo, pagina_de(r))

    # Os projetos que uma pessoa marcou. Quem marcou o quê não aparece para
    # mais ninguém (GEP 0030): só a própria pessoa pede os seus. O GitLab mostra
    # os de qualquer pessoa; aqui, os de outra pessoa são recusados (403).
    rota GET "/api/v4/users/:id/starred_projects"
        definir eu = exigir(superficie.pedir("GET", "user"))
        definir quem = texto(requisicao.parametros.id)
        se texto(eu.corpo.id) != quem e minusculo(texto(eu.corpo.username)) != minusculo(quem)
            exigir(superficie.pedir("GET", ["users", quem]))
            responder(403, {message: "403 Forbidden - the projects a person starred are private"})
        definir consulta = copiar(requisicao.consulta)
        consulta.starred = "true"
        definir r = exigir(superficie.pedir("GET", "projects", nulo, consulta))
        responder(200, r.corpo, pagina_de(r))

    # Merge por PUT, como o GitLab documenta: a mesma ação mesclar (POST).
    rota PUT "/api/v4/projects/:id/merge_requests/:iid/merge"
        definir r = superficie.pedir("POST", adicionar(merge_request_em(requisicao), "merge"), mesclar(requisicao.consulta, requisicao.corpo))
        responder(r.estado, r.corpo)

    # O resumo das aprovações (GEP 0026): quantas são necessárias, quantas
    # faltam e quem aprovou.
    rota GET "/api/v4/projects/:id/merge_requests/:iid/approvals"
        definir mr = exigir(superficie.pedir("GET", merge_request_em(requisicao))).corpo
        definir faltando = obter(mr, "approvals_left", 0)
        responder(200, {id: mr.id, iid: mr.iid, project_id: obter(mr, "project_id", nulo), title: mr.title, description: obter(mr, "description", nulo), state: mr.state, created_at: obter(mr, "created_at", nulo), updated_at: obter(mr, "updated_at", nulo), approvals_required: obter(mr, "approvals_required", 0), approvals_left: faltando, approved: faltando == 0, approved_by: aprovadores(obter(mr, "approved_by_ids", []))})
