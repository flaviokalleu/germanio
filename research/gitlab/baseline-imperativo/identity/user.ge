# User, PersonalAccessToken (app/models/user.rb, personal_access_token.rb)

dados
  usuario interno
    username: texto obrigatorio unico
    email: email obrigatorio unico
    name: texto obrigatorio
    senha_hash: texto obrigatorio
    admin: booleano
    state: texto
    can_create_group: booleano
    projects_limit: inteiro
    failed_attempts: inteiro
    locked_until: texto
    namespace_id: inteiro
    last_sign_in_at: texto

  token_acesso interno
    usuario_id: inteiro obrigatorio indice
    name: texto obrigatorio
    digest: texto obrigatorio unico
    scopes: texto obrigatorio
    expires_at: texto
    revoked: booleano
    last_used_at: texto

logica
  # Users::CreateService — valida e cria o usuário e seu namespace pessoal.
  funcao criar_usuario(dados, admin)
    definir username = cortar(texto(obter(dados, "username", "")))
    definir email = minusculo(cortar(texto(obter(dados, "email", ""))))
    definir nome = cortar(texto(obter(dados, "name", "")))
    definir senha = texto(obter(dados, "password", ""))
    se nome == ""
      erro_validacao("name", "can't be blank")
    se nao caminho_valido(username)
      erro_validacao("username", "is invalid")
    se usuario.existe({username: username}) ou namespace.existe({full_path: username})
      erro_validacao("username", "has already been taken")
    se nao regex.casa("^[^@\s]+@[^@\s]+\.[^@\s]+$", email)
      erro_validacao("email", "is invalid")
    se usuario.existe({email: email})
      erro_validacao("email", "has already been taken")
    se tamanho(senha) < SENHA_MINIMA
      erro_validacao("password", "is too short (minimum is 8 characters)")
    se tamanho(senha) > 128
      erro_validacao("password", "is too long (maximum is 128 characters)")
    definir u = usuario.criar({username: username, email: email, name: nome, senha_hash: cripto.hash_senha(senha), admin: admin, state: "active", can_create_group: verdadeiro, projects_limit: 100000, failed_attempts: 0})
    definir ns = namespace.criar({name: username, path: username, full_path: username, kind: "user", owner_id: u.id, visibility_level: 20})
    retornar usuario.atualizar(u.id, {namespace_id: ns.id})

  # Representação da API (lib/api/entities/user*.rb)
  funcao apresentar_usuario(u, completo)
    definir r = {id: u.id, username: u.username, name: u.name, state: u.state, locked: u.locked_until != nulo e u.locked_until > agora_iso(), avatar_url: nulo, web_url: URL_BASE + "/" + u.username, created_at: u.criado_em}
    se completo
      r.email = u.email
      r.is_admin = u.admin == verdadeiro
      r.can_create_group = u.can_create_group == verdadeiro
      r.projects_limit = u.projects_limit
      r.last_sign_in_at = u.last_sign_in_at
    retornar r

  funcao apresentar_token(t)
    retornar {id: t.id, name: t.name, revoked: t.revoked == verdadeiro, scopes: dividir(t.scopes, ","), user_id: t.usuario_id, expires_at: t.expires_at, last_used_at: t.last_used_at, created_at: t.criado_em, active: nao (t.revoked == verdadeiro) e (t.expires_at == nulo ou t.expires_at >= hoje())}

  definir ESCOPOS_VALIDOS = ["api", "read_api", "read_user", "read_repository", "write_repository"]

  # PersonalAccessTokens::CreateService — o token só é exibido uma vez.
  funcao criar_token(u, dados)
    definir nome = cortar(texto(obter(dados, "name", "")))
    se nome == ""
      erro_validacao("name", "can't be blank")
    definir escopos = obter(dados, "scopes", [])
    se eh_texto(escopos)
      definir escopos = dividir(escopos, ",")
    se tamanho(escopos) == 0
      erro_validacao("scopes", "can't be blank")
    para cada e1 em escopos
      se indice_de(ESCOPOS_VALIDOS, e1) < 0
        erro_validacao("scopes", "contains invalid scope " + texto(e1))
    definir expira = obter(dados, "expires_at", somar_dias(hoje(), 365))
    se expira < hoje()
      erro_validacao("expires_at", "must be in the future")
    definir segredo = "glpat-" + cripto.token(20)
    definir t = token_acesso.criar({usuario_id: u.id, name: nome, digest: cripto.sha256(segredo), scopes: juntar(escopos, ","), expires_at: expira, revoked: falso})
    definir r = apresentar_token(t)
    r.token = segredo
    retornar r

  # Semeia o administrador inicial (GITLAB_ROOT_PASSWORD), como na instalação do GitLab.
  definir senha_root = ambiente.ler("GITLAB_ROOT_PASSWORD", nulo)
  se senha_root != nulo e usuario.contar() == 0
    criar_usuario({username: "root", email: "admin@example.com", name: "Administrator", password: senha_root}, verdadeiro)
