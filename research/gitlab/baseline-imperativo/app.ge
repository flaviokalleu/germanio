# GitLab FOSS reimplementado em Germanio.
# Todo o produto (usuários, grupos, projetos, repositórios, issues, merge
# requests, CI) está nestes arquivos .ge; o runtime só fornece mecanismos
# genéricos (banco, rotas, cripto, git, tarefas, processos, ui).

sistema gitlab

importar "config/app.ge"
importar "identity/user.ge"
importar "identity/auth.ge"
importar "identity/routes.ge"
importar "groups/namespace.ge"
importar "groups/routes.ge"
importar "projects/project.ge"
importar "projects/permissions.ge"
importar "projects/routes.ge"
