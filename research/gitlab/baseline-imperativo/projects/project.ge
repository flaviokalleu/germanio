# Project, ProtectedBranch (app/models/project.rb, protected_branch.rb)

dados
  projeto interno
    name: texto obrigatorio
    path: texto obrigatorio
    full_path: texto obrigatorio unico
    namespace_id: inteiro obrigatorio indice
    description: texto_longo
    visibility_level: inteiro
    default_branch: texto
    creator_id: inteiro
    archived: booleano
    repo: texto
    last_activity_at: texto
    public_builds: booleano
    only_allow_merge_if_pipeline_succeeds: booleano
    ci_config_path: texto

  branch_protegida interno
    projeto_id: inteiro obrigatorio
    name: texto obrigatorio
    push_access_level: inteiro obrigatorio
    merge_access_level: inteiro obrigatorio
    allow_force_push: booleano
    unico(projeto_id, name)

logica
  # Resolve :id da API: número ou caminho url-encoded ("grupo%2Fprojeto").
  funcao projeto_por_ref(ref)
    definir p = nulo
    se eh_numero(ref)
      definir p = projeto.buscar(ref)
    senao
      definir p = projeto.encontrar({full_path: ref})
    se p == nulo
      falhar(404, "404 Project Not Found")
    retornar p

  # Leitura com a mesma resposta 404 para "não existe" e "sem acesso",
  # como o GitLab (não vaza a existência de projetos privados).
  funcao projeto_legivel(requisicao, u)
    definir p = projeto_por_ref(requisicao.parametros.id)
    se nao pode(u, p, "ler_projeto")
      falhar(404, "404 Project Not Found")
    retornar p

  funcao exigir_permissao(u, p, acao)
    se nao pode(u, p, acao)
      falhar(403, "403 Forbidden")

  # Hashed storage: @hashed/aa/bb/<sha256(id)>.git
  funcao caminho_repositorio(id)
    definir h = cripto.sha256(texto(id))
    retornar "@hashed/" + substring(h, 0, 2) + "/" + substring(h, 2, 4) + "/" + h + ".git"

  funcao apresentar_projeto(p, u)
    definir ns = namespace.buscar(p.namespace_id)
    definir r = {id: p.id, name: p.name, path: p.path, path_with_namespace: p.full_path, name_with_namespace: ns.name + " / " + p.name, description: p.description, visibility: nome_visibilidade(p.visibility_level), default_branch: p.default_branch, archived: p.archived == verdadeiro, namespace: apresentar_namespace(ns), web_url: URL_BASE + "/" + p.full_path, http_url_to_repo: URL_BASE + "/" + p.full_path + ".git", readme_url: nulo, created_at: p.criado_em, last_activity_at: p.last_activity_at, creator_id: p.creator_id, empty_repo: git.vazio(p.repo), public_jobs: p.public_builds == verdadeiro, only_allow_merge_if_pipeline_succeeds: p.only_allow_merge_if_pipeline_succeeds == verdadeiro}
    se u != nulo
      definir nivel = nivel_no_projeto(u, p)
      r.permissions = {project_access: nulo, group_access: nulo, access_level: nivel}
    retornar r

  # Projects::CreateService
  funcao criar_projeto(u, dados)
    definir nome = cortar(texto(obter(dados, "name", "")))
    definir caminho = obter(dados, "path", nulo)
    se nome == "" e caminho != nulo
      definir nome = caminho
    se nome == ""
      erro_validacao("name", "can't be blank")
    se caminho == nulo
      definir caminho = caminho_de_nome(nome)
    se nao caminho_valido(caminho)
      erro_validacao("path", "must not start with '-', end in '.git' or '.atom', and contain only letters, digits, '_', '-' and '.'")
    definir ns = namespace.buscar(obter(dados, "namespace_id", u.namespace_id))
    se ns == nulo
      falhar(404, "404 Namespace Not Found")
    se ns.kind == "user"
      se ns.owner_id != u.id e nao u.admin
        falhar(403, "403 Forbidden")
    senao
      se nivel_no_namespace(u, ns) < NIVEL.developer
        falhar(403, "403 Forbidden")
    definir completo = ns.full_path + "/" + caminho
    se projeto.existe({full_path: completo}) ou namespace.existe({full_path: completo})
      erro_validacao("path", "has already been taken")
    definir vis = nivel_visibilidade(obter(dados, "visibility", "private"))
    se ns.kind == "group" e vis > ns.visibility_level
      erro_validacao("visibility_level", "private is not allowed in a private group")
    definir ramo = obter(dados, "default_branch", "main")
    definir p = projeto.criar({name: nome, path: caminho, full_path: completo, namespace_id: ns.id, description: obter(dados, "description", ""), visibility_level: vis, default_branch: ramo, creator_id: u.id, archived: falso, last_activity_at: agora_iso(), public_builds: verdadeiro, only_allow_merge_if_pipeline_succeeds: falso})
    definir repo = caminho_repositorio(p.id)
    git.criar(repo, ramo)
    definir p = projeto.atualizar(p.id, {repo: repo})
    se ns.kind == "user"
      membro.criar({source_type: "Project", source_id: p.id, usuario_id: ns.owner_id, access_level: NIVEL.owner, created_by_id: u.id})
    branch_protegida.criar({projeto_id: p.id, name: ramo, push_access_level: NIVEL.maintainer, merge_access_level: NIVEL.maintainer, allow_force_push: falso})
    se obter(dados, "initialize_with_readme", falso) == verdadeiro ou obter(dados, "initialize_with_readme", "") == "true"
      git.commitar(repo, {branch: ramo, mensagem: "Initial commit", autor: {nome: u.name, email: u.email}, acoes: [{acao: "criar", caminho: "README.md", conteudo: "# " + nome + "\n\n" + texto(obter(dados, "description", "")) + "\n"}]})
    registrar_evento(u, p, "created", "Project", p.id)
    retornar p

  # Eventos de atividade (app/models/event.rb) — usado pelo feed do projeto
  funcao registrar_evento(u, p, acao, tipo, alvo_id)
    evento.criar({projeto_id: p.id, autor_id: u.id, action: acao, target_type: tipo, target_id: alvo_id})
    projeto.atualizar(p.id, {last_activity_at: agora_iso()})

  funcao branch_protegida_para(p, ramo)
    retornar branch_protegida.encontrar({projeto_id: p.id, name: ramo})

dados
  evento interno
    projeto_id: inteiro indice
    autor_id: inteiro obrigatorio
    action: texto obrigatorio
    target_type: texto
    target_id: inteiro
    detalhes: texto_longo
