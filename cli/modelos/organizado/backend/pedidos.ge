# Pedidos feitos pelas pessoas.

pedidos
    tem
        quantidade começa com 1

    pertence a
        produto
        usuario

    começa aberto

    pode
        pagar
        cancelar

    acesso
        usuario
            criar seus
            ver seus
            pagar seus
            cancelar seus

    antes de criar
        se produto.buscar(dados.produto_id).estoque < dados.quantidade
            recuse "Estoque insuficiente"
