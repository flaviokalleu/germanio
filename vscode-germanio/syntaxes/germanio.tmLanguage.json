{
  "name": "Germanio",
  "scopeName": "source.germanio",
  "patterns": [
    { "name": "comment.line.germanio", "match": "(#|//).*$" },
    {
      "name": "string.quoted.double.germanio",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        { "name": "constant.character.escape.germanio", "match": "\\\\[nt\"\\\\]" },
        { "name": "variable.other.interpolation.germanio", "match": "\\{[^}]+\\}" }
      ]
    },
    { "name": "keyword.control.germanio", "match": "\\b(mostre|pergunte|mut|const|se|senao|enquanto|para|em|retorne|pare|continue|usa|crie|e|ou|nao)\\b" },
    { "name": "constant.language.germanio", "match": "\\b(verdadeiro|falso|nulo)\\b" },
    { "name": "support.type.germanio", "match": "\\b(texto|inteiro|decimal|bool)\\b" },
    { "name": "constant.numeric.germanio", "match": "\\b[0-9]+(\\.[0-9]+)?(px|rem)?\\b" },
    { "name": "entity.name.function.germanio", "match": "[[:alpha:]_][[:alnum:]_]*(?=\\()" }
  ]
}
