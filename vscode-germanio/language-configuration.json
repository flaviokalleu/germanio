{
  "comments": { "lineComment": "#" },
  "brackets": [["{", "}"], ["[", "]"], ["(", ")"]],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [["{", "}"], ["[", "]"], ["(", ")"], ["\"", "\""]],
  "folding": { "offSide": true },
  "indentationRules": {
    "increaseIndentPattern": "^\\s*((cada\\s.*\\stem|.*\\stem|.*\\spodem?|.*\\spor|permita|tenha|tenha\\s+pap[eé]is|disponibilize\\s+para\\s+integra[cç][aã]o|vocabul[aá]rio\\s+da\\s+integra[cç][aã]o|.*\\srecebe\\s+eventos\\s.*|quando\\s.*|antes\\s+de\\s.*|ao\\s+iniciar|crie\\s+p[aá]gina\\s.*|se\\s.*|sen[aã]o|para\\s+cada\\s.*|enquanto\\s.*|tentar|erro.*|funcao\\s.*|fun[cç][aã]o\\s.*|rota\\s.*|l[oó]gica|dados|rotas))\\s*$",
    "decreaseIndentPattern": "^\\s*(sen[aã]o|erro)\\b"
  },
  "wordPattern": "[\\p{L}_][\\p{L}\\p{N}_]*|-?\\d+(\\.\\d+)?"
}
