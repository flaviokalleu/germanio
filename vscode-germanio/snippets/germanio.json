{
  "Sistema": {
    "prefix": ["crie sistema", "sistema"],
    "body": ["crie sistema ${1:Loja}", "", "tenha ${2:clientes}", "", "cada ${3:cliente} tem", "\t${4:nome obrigatório}", "\t${5:email obrigatório e único}", "", "crie página ${6:Clientes}", "\tmostre ${2:clientes}", "\tpermita", "\t\tcriar", "\t\teditar", "\t\texcluir", "$0"],
    "description": "Um sistema completo: dados, campos e página"
  },
  "Dados com campos": {
    "prefix": ["tem", "cada tem"],
    "body": ["${1:cliente} tem", "\t${2:nome obrigatório}", "\t${3:email obrigatório e único}", "$0"],
    "description": "O que um dado tem"
  },
  "Relação pertence a": {
    "prefix": "pertence",
    "body": "${1:pedido} pertence a ${2:cliente}",
    "description": "Um dado pertence a outro"
  },
  "Login": {
    "prefix": ["tenha login", "login"],
    "body": ["tenha login", "tenha cadastro", "login usa ${1:email}", "$0"],
    "description": "Pessoas entram no sistema (senha guardada com segurança)"
  },
  "Papéis": {
    "prefix": ["tenha papeis", "papeis"],
    "body": ["tenha papeis", "\t${1:leitor}", "\t${2:editor}", "\t${3:dono}", "$0"],
    "description": "Papéis do menor para o maior"
  },
  "Quem pode": {
    "prefix": ["pode", "permissao"],
    "body": ["${1:editor} pode", "\t${2:criar} ${3:pedidos}", "\t${4:editar} ${3:pedidos}", "$0"],
    "description": "O que um papel pode fazer"
  },
  "Somente": {
    "prefix": "somente",
    "body": "somente ${1:administrador} pode ${2:excluir} ${3:pedidos}",
    "description": "Restringe uma ação a um papel"
  },
  "Estados": {
    "prefix": ["começa", "estado"],
    "body": ["${1:pedido} começa ${2:aberto}", "", "${1:pedido} pode", "\t${3:fechar}", "\t${4:reabrir}", "$0"],
    "description": "Estados e transições (fechar → fechado, reabrir → volta ao início)"
  },
  "Quando": {
    "prefix": "quando",
    "body": ["quando ${1:criar} ${2:pedido}", "\t$0"],
    "description": "O que acontece depois de uma ação"
  },
  "Antes de": {
    "prefix": "antes",
    "body": ["antes de ${1:criar} ${2:pedido}", "\tse ${3:dados.total > 1000}", "\t\trecuse \"${4:Pedidos acima de 1000 precisam de aprovação}\"", "$0"],
    "description": "Regra que roda antes e pode recusar"
  },
  "Página": {
    "prefix": ["crie página", "pagina"],
    "body": ["crie página ${1:Pedidos}", "\tmostre ${2:pedidos}", "\tpermita", "\t\tpesquisar", "\t\tcriar", "\t\teditar", "\t\texcluir", "$0"],
    "description": "Uma página conectada, sem código de interface"
  },
  "Integração": {
    "prefix": ["disponibilize", "integração"],
    "body": ["disponibilize para integração", "\t${1:pedidos}", "$0"],
    "description": "Publica os dados para outros sistemas"
  },
  "Se": {
    "prefix": "se",
    "body": ["se ${1:condição}", "\t$0"],
    "description": "Lógica explícita"
  },
  "Para cada": {
    "prefix": "para cada",
    "body": ["para cada ${1:item} em ${2:lista}", "\t$0"],
    "description": "Repete para cada item"
  }
}
